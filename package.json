{
  "name": "cc-pi-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Delegate Claude Code tasks and reviews to local Pi workers",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "package": "node scripts/package.mjs",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/release-notes-generator": "14.1.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "semantic-release": "26.0.1"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "npm": "11.21.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mhosseinab/cc-pi-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/mhosseinab/cc-pi-plugin/issues"
  },
  "homepage": "https://github.com/mhosseinab/cc-pi-plugin#readme"
}
